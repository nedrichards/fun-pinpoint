[Desktop Entry]
Name=Pinpoint
Comment=@TAGLINE@
Exec=pinpoint %f
Icon=@APPLICATION_ID@
Terminal=false
Type=Application
Categories=Office;Presentation;
MimeType=application/x-pinpoint;
StartupNotify=true
DBusActivatable=false
Keywords=presentation;slides;talk;hacker;plain-text;
Actions=NewPresentation;

[Desktop Action NewPresentation]
Name=New Presentation
Exec=pinpoint --edit
Icon=document-new-symbolic
