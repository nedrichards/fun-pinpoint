<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.8"/>
  <object class="AdwShortcutsDialog" id="shortcuts_dialog">
    <child>
      <object class="AdwShortcutsSection">
        <property name="title">Keyboard Shortcuts</property>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Present from a folder</property>
            <property name="action-name">win.open-presentation</property>
            <property name="accelerator">&lt;Primary&gt;o</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Create a presentation</property>
            <property name="action-name">win.new-presentation</property>
            <property name="accelerator">&lt;Primary&gt;n</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Save in composition mode</property>
            <property name="accelerator">&lt;Primary&gt;s</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Complete a setting or asset</property>
            <property name="accelerator">&lt;Primary&gt;space</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Present from composition mode</property>
            <property name="accelerator">&lt;Primary&gt;Return</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Move between editor areas</property>
            <property name="accelerator">F6</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Show keyboard shortcuts</property>
            <property name="action-name">win.show-shortcuts</property>
            <property name="accelerator">question</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Present the selected presentation</property>
            <property name="action-name">win.present-selected</property>
            <property name="accelerator">&lt;Primary&gt;p</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Rehearse the selected presentation</property>
            <property name="action-name">win.rehearse-selected</property>
            <property name="accelerator">&lt;Primary&gt;&lt;Shift&gt;r</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Export the selected presentation to PDF</property>
            <property name="action-name">win.export-selected</property>
            <property name="accelerator">&lt;Primary&gt;e</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Next slide (also Down, Space, Page Down, Forward, and Media Next)</property>
            <property name="accelerator">Right</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Previous slide (also Up, Backspace, Page Up, Back, and Media Previous)</property>
            <property name="accelerator">Left</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">First slide (also H)</property>
            <property name="accelerator">Home</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Toggle fullscreen (also F)</property>
            <property name="accelerator">F11</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Blank the audience screen</property>
            <property name="accelerator">B</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Show speaker view</property>
            <property name="accelerator">F1</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Run the slide command</property>
            <property name="accelerator">Return</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Edit the slide command</property>
            <property name="accelerator">Tab</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Quit Pinpoint (also Q)</property>
            <property name="accelerator">Escape</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Swap audience and speaker displays</property>
            <property name="accelerator">S</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
